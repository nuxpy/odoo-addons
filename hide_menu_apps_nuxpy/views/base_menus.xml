<odoo>
    <data>

        <record id="base.open_module_tree" model="ir.actions.act_window">
            <field name="name">Apps</field>
            <field name="res_model">ir.module.module</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="context">{'search_default_app': 1}</field>
            <field name="search_view_id" ref="base.view_module_filter"/>
            <field name="groups_id" eval="[(6, 0, [ref('base.user_admin')])]"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_empty_folder">
                    No module found!
                </p><p>
                    You should try other search criteria.
                </p>
            </field>
        </record>

        <menuitem
            id="base.menu_management"
            name="Apps"
            sequence="500"
            web_icon="base,static/description/modules.png"
            groups="base.user_admin"/>
        
    </data>
</odoo>
